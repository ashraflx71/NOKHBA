# Copy to wrangler.toml and replace the D1 database_id after creating a NEW D1 database.
name = "nokhba-ai-admin"
main = "worker.js"
compatibility_date = "2026-11-19"

[[d1_databases]]
binding = "DB"
database_name = "nokhba-ai"
database_id = "REPLACE_WITH_YOUR_D1_DATABASE_ID"

[vars]
# Example: https://your-team.cloudflareaccess.com
ACCESS_TEAM_DOMAIN = "REPLACE_WITH_ACCESS_TEAM_DOMAIN"
# Application AUD from the Cloudflare Access application.
ACCESS_AUD = "REPLACE_WITH_ACCESS_APPLICATION_AUD"

# Add AI_API_URL and AI_MODEL only after choosing a compatible provider.
# Store AI_API_KEY as a Worker secret; never put it in this file or browser code.
